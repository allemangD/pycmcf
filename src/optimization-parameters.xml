<?xml version="1.0"?>
<optimization-parameters>
    <optimization-method-type>ScipyLBFGS</optimization-method-type>
    <max-iterations>20</max-iterations>
    <max-line-search-iterations>7</max-line-search-iterations>
    <convergence-tolerance>5e-3</convergence-tolerance>
    <gpu-mode>none</gpu-mode>
    <save-every-n-iters>50</save-every-n-iters>
    <use-sobolev-gradient>On</use-sobolev-gradient>
    <freeze-template>Off</freeze-template>
    <freeze-control-points>Off</freeze-control-points>
    <memory-length>1</memory-length>
    <use-rk2>Off</use-rk2>
</optimization-parameters>
