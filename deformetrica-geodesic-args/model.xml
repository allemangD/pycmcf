<?xml version="1.0"?>
<model>

  <model-type>PrincipalGeodesicAnalysis</model-type>
  <dimension>3</dimension>
  <latent-space-dimension>1</latent-space-dimension>

  <template>
    <object id="surf">
      <deformable-object-type>SurfaceMesh</deformable-object-type>
      <attachment-type>Varifold</attachment-type>
      <noise-std>0.1</noise-std>
      <kernel-width>0.15</kernel-width>
      <kernel-type>keops</kernel-type>
      <filename>template.vtk</filename>
    </object>
  </template>

  <deformation-parameters>
    <kernel-width>0.15</kernel-width>
    <kernel-type>keops</kernel-type>
  </deformation-parameters>
</model>
